BoxLayout:
    orientation: 'vertical'
    padding: 10
    spacing: 10

    BoxLayout:
        orientation: 'horizontal'
        spacing: 10

        TextInput:
            id: input_miles
            text: '0'
            multiline: False
            font_size: 32
            foreground_color: (1, 1, 1, 1)
            background_color: (0, 0, 0, 1)

        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.3
            spacing: 5

            Button:
                text: 'Up'
                on_press: app.handle_increment(1)
                background_color: (0.2, 0.2, 0.2, 1)
                color: (1, 1, 1, 1)

            Button:
                text: 'Down'
                on_press: app.handle_increment(-1)
                background_color: (0.2, 0.2, 0.2, 1)
                color: (1, 1, 1, 1)

    Button:
        text: 'Convert miles to km'
        on_press: app.handle_calculate()
        size_hint_y: None
        height: 50
        background_color: (0.2, 0.2, 0.2, 1)
        color: (1, 1, 1, 1)

    Label:
        text: app.output_text
        font_size: 48
        color: (1, 1, 0, 1)  # Yellow text
        size_hint_y: None
        height: 100
        canvas.before:
            Color:
                rgba: (0, 0, 0, 1)  # Black background
            Rectangle:
                pos: self.pos
                size: self.size


